# === AI Agent (LM Studio) ===
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=lms-7b

# === News Analysis ===
NEWS_CATEGORY=technology
NEWS_MAX_ITEMS=50
NEWS_CONFIDENCE_THRESHOLD=0.6

# === Technical Analysis ===
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_STD=2
HISTORY_DAYS=90

# === Risk Management ===
MAX_POSITION_PCT=0.10
MIN_SIGNAL_CONFIDENCE=0.7
MAX_DAILY_TRADES=10
MAX_PORTFOLIO_RISK_PCT=0.02

# === Execution ===
ORDER_TYPE=MKT
AUTO_EXECUTE=true
PAPER_ACCOUNT=true

# === Scheduling ===
RUN_MODE=continuous
SCHEDULE_CRON=0 9 * * *
EXECUTION_INTERVAL=7200
LOG_RETENTION_DAYS=30

# === Logging ===
LOG_LEVEL=INFO
