# === API Keys ===
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === IBKR ===
IBKR_ACCOUNT_ID=
IBKR_INSYNC_HOST=localhost
IBKR_INSYNC_PORT=7497

# === AI Agent (LM Studio) ===
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=lms-7b

# === News Analysis ===
NEWS_CATEGORY=technology
NEWS_MAX_ITEMS=50
NEWS_CONFIDENCE_THRESHOLD=0.6

# === Technical Analysis ===
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
HISTORY_DAYS=90

# === Signal Engine ===
ROC_PERIOD=10
VOLUME_LOOKBACK=20
BUY_THRESHOLD=0.3
SELL_THRESHOLD=-0.3

# === Aggregation Weights ===
WEIGHT_MACD=0.5
WEIGHT_VOLUME=0.3
WEIGHT_ROC=0.2

# === Confidence Scaling ===
MACD_CONFIDENCE_MULTIPLIER=10
ROC_CONFIDENCE_SCALE=20
VOLUME_CONFIDENCE_HIGH_SCALE=3.0
VOLUME_CONFIDENCE_LOW_SCALE=2.0

# === Risk Management ===
MIN_SIGNAL_CONFIDENCE=0.7

# === Execution ===
ORDER_TYPE=MKT
PAPER_ACCOUNT=true

# === Execution Deadlines ===
SIGNAL_DEADLINE=300
EXECUTION_DEADLINE=300

# === Retry & Backoff ===
RETRY_MAX_RETRIES=5
RETRY_DELAY_FACTOR=1.0
RETRY_MAX_DELAY=30.0
IBKR_RETRY_MAX_RETRIES=3
IBKR_RETRY_DELAY_FACTOR=1.0
IBKR_RETRY_MAX_DELAY=30.0
IBKR_ORDER_RETRY_MAX_RETRIES=1

# === Infrastructure ===
DB_PATH=data/stock_market_expert.db
LOG_DIR=logs
IBKR_API_TIMEOUT=10

# === Scheduling ===
RUN_MODE=continuous
EXECUTION_INTERVAL=7200

# === Logging ===
LOG_LEVEL=INFO
